# Security Headers (all pages)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML - no cache
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://vitals.vercel-insights.com

# Static assets - aggressive cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Bible data - moderate cache
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Service Worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Manifest
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json

# Sitemap & Robots
/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=86400
