{
  "name": "celestialworship",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && eslint src --max-warnings 0 && vitest run && vite build",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:hymns": "python scripts/build_hymns.py --report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.12",
